# ── rule provider anchors ─────────────────────────────────────────────────────
# Modify these anchors to update all rule-providers of each type at once.
# e.g. change interval: 86400 → interval: 43200 here to halve the refresh interval.
_p_domain: &RuleProviderDomain
  type: http
  behavior: domain
  interval: 86400
  format: yaml
_p_ipcidr: &RuleProviderIPCIDR
  type: http
  behavior: ipcidr
  interval: 86400
  format: yaml
_p_classical: &RuleProviderClassical
  type: http
  behavior: classical
  interval: 86400
  format: yaml
_p_domain_mrs: &RuleProviderDomain_mrs
  type: http
  behavior: domain
  interval: 86400
  format: mrs
_p_ipcidr_mrs: &RuleProviderIPCIDR_mrs
  type: http
  behavior: ipcidr
  interval: 86400
  format: mrs

# ── rule providers ─────────────────────────────────────────────────────────────
rule-providers:
{% for prov in providers %}  {{ prov.key }}:
    <<: *{{ prov.anchor }}
    url: '{{ prov.url }}'
    path: {{ prov.path }}
{% endfor %}
